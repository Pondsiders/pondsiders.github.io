source "https://rubygems.org"

# Match what GitHub Pages actually runs in production.
# Pinned versions: https://pages.github.com/versions/
gem "github-pages", group: :jekyll_plugins

# Plugins not included in the github-pages bundle by default.
group :jekyll_plugins do
  gem "jekyll-include-cache"
end

# Required for Ruby 3.0+ — webrick was removed from stdlib.
gem "webrick"
gem "csv"
gem "bigdecimal"